# Leave false until the Light server, migration, signing key and plans are ready.
VITE_LIGHT_LICENSING_ENABLED=false
# HTTPS origin of the separate Light licensing service.
VITE_LIGHT_API_ORIGIN=
# Public P-256 JWK generated by the website's scripts/light-signing-key.cjs.
# Never put a private key, Supabase service-role key or PayMongo key in this app.
VITE_LIGHT_PUBLIC_KEY_JWK=
